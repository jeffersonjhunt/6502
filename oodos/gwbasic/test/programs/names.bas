10 REM names: 40 characters kept, types apart, the defaults
20 AB=1 : ABC=2 : ABCD=3 : A=4 : PRINT AB;ABC;ABCD;A
30 A%=5 : A!=6 : A#=7 : A$="8" : PRINT A;A%;A!;A#;A$
40 LONGNAME=9 : LONGNAMES=10 : LONGNAM=11 : PRINT LONGNAME;LONGNAMES;LONGNAM
50 X1=12 : X2=13 : X.Y=14 : X..=15 : PRINT X1;X2;X.Y;X..
60 B23456789012345678901234567890123456789X=16
70 B23456789012345678901234567890123456789Y=17
80 PRINT B23456789012345678901234567890123456789X;B23456789012345678901234567890123456789Y
90 PRINT UNDEF;UNDEF%;UNDEF#;"<";UNDEF$;">";LEN(UNDEF$)
100 Z=Z+1 : Z=Z+1 : Z$=Z$+"Z" : Z$=Z$+"Z" : PRINT Z;Z$
110 C%=32767 : C=C%+1 : PRINT C%;C
120 Q=1 : QQ=2 : QQQ=3 : Q1=4 : PRINT Q;QQ;QQQ;Q1;Q+QQ+QQQ+Q1
130 A.1=1 : A1.=2 : PRINT A.1;A1.;A
140 M%=1 : M%=M%+M% : M%=M%*M% : PRINT M%;M
