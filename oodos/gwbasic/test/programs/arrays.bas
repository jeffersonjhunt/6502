10 REM arrays: every type, one to three dimensions, DIM and the implicit 10
20 DIM A%(5),B!(3,4),C#(2,2,2),D$(6),E(1,1,1,1)
30 A%(0)=-1 : A%(5)=32767 : PRINT A%(0);A%(1);A%(5)
40 B!(3,4)=1.5 : B!(0,0)=-2 : B!(2,3)=B!(3,4)*2 : PRINT B!(3,4);B!(0,0);B!(2,3);B!(3,3)
50 C#(2,2,2)=CDBL(1)/3 : C#(1,0,2)=CDBL(12345)*1000+678 : PRINT C#(2,2,2);C#(1,0,2);C#(0,0,0)
60 D$(6)="LAST" : D$(0)="FIRST" : PRINT D$(0);"/";D$(3);"/";D$(6);LEN(D$(3))
70 E(1,1,1,1)=4 : E(0,1,0,1)=2 : PRINT E(1,1,1,1)+E(0,1,0,1);E(1,0,1,0)
80 F(10)=10 : F(0)=1 : PRINT F(10);F(5);F(0)
90 G%(10,10)=7 : G%(3,9)=G%(10,10)+1 : PRINT G%(10,10);G%(3,9);G%(9,3)
100 H$(2)="X" : H$(10)=H$(2)+"Y" : PRINT H$(10);H$(2);LEN(H$(0))
110 I=3 : J=2 : B!(I,J+1)=9 : PRINT B!(3,3);B!(I,I)
120 K(1)=1 : K!(1)=2 : K%(1)=3 : K#(1)=4 : K$(1)="5" : K=6
130 PRINT K(1);K!(1);K%(1);K#(1);K$(1);K
140 L(L(0)+1)=5 : L(L(1))=6 : PRINT L(0);L(1);L(5)
150 M(2.6)=3 : PRINT M(3);M(2)
160 N$(1)="A" : N$(2)="B" : PRINT N$(1)+N$(2)+N$(1);N$(1)<N$(2)
170 DIM P(0),Q$(0,0) : P(0)=8 : Q$(0,0)="Q" : PRINT P(0);Q$(0,0)
180 DIM R%(2),S%(2),T%(2)
190 R%(2)=1 : S%(2)=2 : T%(2)=3 : PRINT R%(2);S%(2);T%(2)
200 U=1 : V(1)=2 : W=3 : PRINT U;V(1);W
210 DIM X(3) : X(3)=4 : Y=X(3)*2 : PRINT Y;X(3)
220 DIM Z%(100) : Z%(100)=100 : Z%(50)=50 : PRINT Z%(100);Z%(50);Z%(99)
