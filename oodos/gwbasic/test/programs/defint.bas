10 REM DEFINT DEFSNG DEFDBL DEFSTR
20 A=1.5 : PRINT A
30 DEFINT A-C : A=1.5 : B=2.5 : C=-1.5 : D=1.5 : PRINT A;B;C;D;A!
40 DEFSTR S,T-U : S="S" : T="T" : U="U" : PRINT S;T;U;S+T+U;V
50 DEFDBL X-Z : X=1/3 : PRINT X;X!;X%
60 DEFSNG A : A=2.25 : PRINT A;A%
70 DEFINT I-K,N : I=7.6 : J=I/2 : K=J*3 : N=32767 : PRINT I;J;K;N
80 DEFSTR W : DEFINT W : W=3.4 : PRINT W;W$
90 DEFSNG A-Z : E=1/3 : S!=2 : PRINT E;S!;S$
100 DEFINT Q-Q : Q=1.6 : PRINT Q
110 DEFDBL G,H : G=1/7 : H=G*7 : PRINT G;H
