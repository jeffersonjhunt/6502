10 REM more: long names inside subscripts, copies, the high characters, VAL's zero
20 LONGINDEX=2 : SHORT=1 : DIM LONGARRAYNAME(5,5),LONGNAMES$(4)
30 LONGARRAYNAME(LONGINDEX+1,LONGINDEX)=7 : PRINT LONGARRAYNAME(3,2);LONGARRAYNAME(LONGINDEX,LONGINDEX+1)
40 LONGNAMES$(LONGINDEX)="L" : LONGNAMES$(SHORT)=LONGNAMES$(LONGINDEX)+"M"
50 PRINT LONGNAMES$(1);LONGNAMES$(2);LEN(LONGNAMES$(3))
60 LONGARRAYNAME(LONGARRAYNAME(3,2)-6,LONGARRAYNAME(3,2)-5)=9 : PRINT LONGARRAYNAME(1,2)
70 Q(LONGARRAYNAME(1,2))=4 : PRINT Q(9);LONGARRAYNAME(LONGARRAYNAME(1,2)-8,2)
80 A$=UNDEFINED$ : PRINT LEN(A$);"<";A$;">" : B$="SELF" : B$=B$ : PRINT B$
90 C$=CHR$(200) : PRINT C$>"Z";CHR$(128)>CHR$(127);CHR$(0)<"";""<CHR$(0);ASC(C$)
100 PRINT STR$(CDBL(1)/3);"|";STR$(CDBL(2)^0.5);"|"
110 DIM SV : SV=5 : PRINT SV
120 D$(1)="12" : D$(2)="34" : D$(3)=D$(1)+D$(2) : PRINT VAL(D$(1));VAL(D$(2));VAL(D$(3))
130 E$="56" : F$="78" : G$=E$+F$ : H$=LEFT$(G$,2) : PRINT VAL(H$);VAL(MID$(G$,2,2));G$
140 PRINT LEFT$("ABCDEF",LEN("XYZ"));RIGHT$("ABCDEF",LEN(E$+F$)-1)
150 I$(0)="P" : I$(1)=I$(0) : I$(0)="R" : PRINT I$(0);I$(1)
160 J=1 : J$="J" : J%=2 : J(1)=3 : J$(1)="K" : PRINT J;J$;J%;J(1);J$(1)
170 PRINT INSTR("ABC",CHR$(66));INSTR(2,"ABCABC","C");INSTR(4,"ABCABC","C")
180 PRINT "X"+STR$(1)+HEX$(10)+OCT$(9)+CHR$(90)+SPACE$(2)+"Y"
