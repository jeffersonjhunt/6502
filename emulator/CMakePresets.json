{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug + ASan/UBSan + tests",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EMU_SANITIZE": "ON",
        "EMU_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Optimised, no tests",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EMU_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "trace",
      "displayName": "Debug with EMU_LOGV tracing compiled in",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/trace",
      "cacheVariables": {
        "EMU_TRACE": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "trace", "configurePreset": "trace" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    }
  ]
}
