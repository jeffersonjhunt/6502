{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Debug + ASan/UBSan + tests",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EMU_SANITIZE": "ON",
        "EMU_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Optimised, no tests",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EMU_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "trace",
      "displayName": "Debug with EMU_LOGV tracing compiled in",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/trace",
      "cacheVariables": {
        "EMU_TRACE": "ON"
      }
    },
    {
      "name": "web",
      "displayName": "WebAssembly (Emscripten), Release + the tests that run under node",
      "binaryDir": "${sourceDir}/build/web",
      "generator": "Ninja",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EMU_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "trace",
      "configurePreset": "trace"
    },
    {
      "name": "web",
      "configurePreset": "web"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "web",
      "configurePreset": "web",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
