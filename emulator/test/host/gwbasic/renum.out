Okÿ
10 REM every kind of line reference
20 ON ERROR GOTO 500
30 GOSUB 300:IF A=0 THEN 50 ELSE 40
40 PRINT "forty"
50 A=A+1:IF A<3 THEN 30
60 ON A GOTO 70,80,90
70 PRINT "seventy"
80 PRINT "eighty"
90 ON A-1 GOSUB 300,310
100 RESTORE 400:READ X$:PRINT X$
110 ERROR 5
120 IF ERL=110 THEN PRINT "erl" ELSE 140
130 IF 110=ERL THEN PRINT "erl2"
140 IF ERL<>110 THEN 150 ELSE ERROR 6
150 PRINT "end":RUN 170
160 LIST 10-20:LLIST 30:DELETE 40-50:EDIT 60:AUTO 70,10:RENUM 80,90:GOTO 999
170 PRINT "run 170":END
300 PRINT "sub";A;:RETURN
310 PRINT "sub310";:GOSUB 320:RETURN
320 RETURN 330
330 PRINT "r330":RETURN
400 DATA four hundred
500 PRINT "trap";ERR;ERL
510 IF ERR=5 THEN RESUME 120
520 IF ERR=6 THEN RESUME NEXT
530 ON ERROR GOTO 0
RUN
sub 0 sub 1 forty
sub 2 forty
sub310r330
four hundred
trap 5  110 
erl
erl2
trap 6  140 
end
run 170
Okÿ
