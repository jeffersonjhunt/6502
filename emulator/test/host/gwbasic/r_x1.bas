10 OPEN "R",#1,"RX1.DAT",100
20 FIELD #1,100 AS A$
30 FOR I=1 TO 5:R$="":FOR J=1 TO 100:R$=R$+CHR$(65+(I*7+J) MOD 26):NEXT:LSET A$=R$:PUT #1,I:NEXT
40 CLOSE
50 OPEN "R",#1,"RX1.DAT",100
60 FIELD #1,50 AS B$,50 AS C$
70 FOR I=1 TO 5:R$="":FOR J=1 TO 100:R$=R$+CHR$(65+(I*7+J) MOD 26):NEXT:GET #1,I:PRINT I;LEFT$(B$,4);RIGHT$(C$,4);B$+C$=R$;LOC(1):NEXT
80 CLOSE
