10 REM NAME: a file renamed, then read by its new name; the errors
20 ON ERROR GOTO 900
30 OPEN "O",#1,"DN1.TXT":PRINT #1,"renamed":CLOSE
40 PRINT "a":NAME "DN1.TXT" AS "DN2.TXT"
50 PRINT "b":OPEN "I",#1,"DN2.TXT":LINE INPUT #1,A$:PRINT A$:CLOSE
60 PRINT "c":OPEN "I",#1,"DN1.TXT"
70 PRINT "d":NAME "DN1.TXT" AS "DN3.TXT"
80 PRINT "e":OPEN "O",#1,"DN4.TXT":CLOSE:NAME "DN2.TXT" AS "DN4.TXT"
90 PRINT "f":OPEN "I",#1,"DN2.TXT":LINE INPUT #1,A$:PRINT A$:CLOSE
100 PRINT "g":OPEN "I",#2,"DN2.TXT":NAME "dn2.txt" as "DN5.TXT"
110 PRINT "h":CLOSE:NAME "dn2.txt" AS "dn5.txt":OPEN "I",#1,"DN5.TXT":LINE INPUT #1,A$:PRINT A$:CLOSE
120 PRINT "i":NAME "" AS "DN6.TXT"
130 PRINT "j":NAME "DN5.TXT" AS ""
140 PRINT "k":NAME 1 AS "DN6.TXT"
150 PRINT "l":NAME "DN5.TXT" AS 2
160 PRINT "m":KILL "DN4.TXT":KILL "DN5.TXT"
170 PRINT "done":END
900 PRINT "error";ERR;"in";ERL:RESUME NEXT
