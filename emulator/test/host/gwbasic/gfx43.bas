10 REM 7e5's G42: GET and PUT in SCREEN 10, 11 and 12 (rows of up to 256 bytes through TXBUF in pieces), the
20 REM tiles and POINT, by hand; the test types SCREEN n:MX=..:MC=..:T$=..:GOSUB 1000
30 DEFINT A-Z: DIM B(300),C(10): END
1000 CLS 2: GET (0,0)-(9,9),B: H$=STR$(B(0))+STR$(B(1))
1010 FOR X=0 TO MX: PSET (X,0),X MOD (MC+1): PSET (X,1),MC-(X MOD (MC+1)): NEXT
1020 GET (0,0)-(MX,1),B: PUT (0,100),B,PSET: LINE (0,110)-(MX,111),85 AND MC,BF: PUT (0,110),B,OR
1030 LINE (0,120)-(MX,121),85 AND MC,BF: PUT (0,120),B,AND: PUT (0,130),B,PRESET
1040 LINE (0,140)-(MX,141),85 AND MC,BF: PUT (0,140),B,XOR: GET (1,0)-(MX-1,1),B: PUT (1,150),B,PSET
1050 FOR I=0 TO 10: C(I)=0: NEXT: PSET (1,3),1 AND MC: PSET (2,3),2 AND MC: PSET (3,3),3 AND MC: PSET (4,3),4 AND MC: GET (1,3)-(4,3),C
1060 LINE (10,160)-(60,200),MC,B: PAINT (30,170),T$,MC: PSET (3,5),MC+55*(MC=255): R=POINT(3,5)
1070 PRINT "H";H$;" C ";HEX$(C(0));" ";HEX$(C(1));" ";HEX$(C(2));" ";HEX$(C(3));" R";R: PRINT "DONE": RETURN
