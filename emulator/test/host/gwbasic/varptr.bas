10 A%=1:B=2:C$="x":D#=3
20 PRINT ASC(VARPTR$(A%));ASC(VARPTR$(B));ASC(VARPTR$(C$));ASC(VARPTR$(D#))
30 DIM E(2),F$(1):PRINT ASC(VARPTR$(E(1)));ASC(VARPTR$(F$(0)));LEN(VARPTR$(B))
40 V$=VARPTR$(B):PRINT ASC(MID$(V$,2))+256*ASC(MID$(V$,3))=VARPTR(B)
50 V$=VARPTR$(E(2)):PRINT ASC(MID$(V$,2))+256*ASC(MID$(V$,3))=VARPTR(E(2))
