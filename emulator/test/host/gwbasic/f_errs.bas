10 REM the file errors
20 ON ERROR GOTO 900
30 OPEN "O",#1,"FX1.TXT":PRINT #1,"X":CLOSE #1
40 PRINT "a":OPEN "I",#0,"FX1.TXT"
50 PRINT "b":PRINT #2,"X"
60 PRINT "c":OPEN "I",#1,"NOSUCH.TXT"
70 PRINT "d":OPEN "Q",#1,"FX1.TXT"
80 PRINT "e":OPEN "I",#1,"FX1.TXT":PRINT #1,"Y"
90 PRINT "f":INPUT #1,A$:INPUT #1,B$
100 PRINT "g":OPEN "I",#1,"FX1.TXT"
110 PRINT "h":CLOSE:OPEN "O",#2,"FX2.TXT":INPUT #2,A$
120 PRINT "i":LINE INPUT #2,A$
130 PRINT "j":PRINT EOF(2)
140 PRINT "k":OPEN "O",#1,"FX*.TXT"
150 PRINT "l":OPEN "O",#3,"FX2.TXT"
160 PRINT "m":PRINT EOF(3)
170 PRINT "n":PRINT LOC(0)
180 PRINT "o":OPEN "",#1,"FX1.TXT"
190 PRINT "p":X$=INPUT$(0,#2)
200 PRINT "q":X$=INPUT$(1,#2)
210 PRINT "r":OPEN "O",#1,"FX?.TXT"
240 PRINT "u":OPEN "O",#1,"FX1.TXT" FOR OUTPUT AS #2
250 PRINT "v":OPEN "FX1.TXT" FOR INPUT AS #1 LEN=10
260 PRINT "w":CLOSE #300
270 PRINT "x":OPEN 1,#1,"FX1.TXT"
275 PRINT "y":OPEN "O",#4,"FX4.TXT"
280 PRINT "done":CLOSE:END
900 PRINT "error";ERR;"in";ERL:RESUME NEXT
