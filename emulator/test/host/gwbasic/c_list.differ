# the 1983 source: LLIST goes on into LIST (GWLIST.ASM), so LLIST n,"name" lists to the file as LIST does; and a drive past P: is Bad file name (the OO-1's drives, PARDEV), where PC-BASIC gives Syntax error and Path not found
Ok
10 PRINT "HELLO"
20 REM LISTED
30 END
LIST ,"L1.TXT"
Ok
LIST 20-,"L2.TXT"
Ok
LLIST 10,"L3.TXT"
Ok
OPEN "I",#1,"L1.TXT":FOR I=1 TO 3:LINE INPUT #1,A$:PRINT A$:NEXT:?EOF(1):CLOSE
10 PRINT "HELLO"
20 REM LISTED
30 END
-1 
Ok
OPEN "I",#1,"L2.TXT":FOR I=1 TO 2:LINE INPUT #1,A$:PRINT A$:NEXT:?EOF(1):CLOSE
20 REM LISTED
30 END
-1 
Ok
OPEN "I",#1,"L3.TXT":LINE INPUT #1,A$:PRINT A$:?EOF(1):CLOSE
10 PRINT "HELLO"
-1 
Ok
NEW
Ok
LOAD "L1.TXT"
Ok
LIST
10 PRINT "HELLO"
20 REM LISTED
30 END
Ok
LIST ,
Missing operand
Ok
LIST 10,"Q:X"
Bad file name
Ok
