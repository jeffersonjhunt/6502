10 A%=1:B%=2:SWAP A%,B%:PRINT A%;B%
20 A=1.5:B=-2.25:SWAP A,B:PRINT A;B
30 A#=1.23456789012345#:B#=2:SWAP A#,B#:PRINT A#;B#
40 A$="one":B$="two":SWAP A$,B$:PRINT A$;" ";B$
50 DIM X(5),Y$(3):X(2)=7:X(4)=9:SWAP X(2),X(4):PRINT X(2);X(4)
60 Y$(1)="first":SWAP Y$(1),A$:PRINT Y$(1);" ";A$
70 SWAP A,X(2):PRINT A;X(2)
80 SWAP A$,A$:PRINT A$
90 C%=5:SWAP C%,C%:PRINT C%
100 I=1:J=3:Y$(I)="p":Y$(J)="q":SWAP Y$(I),Y$(J):PRINT Y$(1);Y$(3)
110 S$="":T$="x":SWAP S$,T$:PRINT "[";S$;"][";T$;"]"
120 Q=3:SWAP Z9,Q:PRINT Z9;Q
130 LONGNAME2=8:SWAP LONGNAME1,LONGNAME2:PRINT LONGNAME1;LONGNAME2
140 X(1)=6:SWAP X(1),W(2):PRINT X(1);W(2)
150 SWAP Y$(LEN(STRING$(2,"a"))),A$:PRINT Y$(2);" ";A$
