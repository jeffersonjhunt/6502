10 REM listing: tokens and constants back as GW-BASIC lists them
15 GOTO 180
20 A=1:B%=2:C!=3.5:D#=1.25#:E$="Hi":F=100000!:G=1E+10:H#=1500#
30 PRINT A;B%;C!;D#;E$,F;G;H#
40 IF A=1 THEN 60 ELSE 50
50 GOTO 10:GOSUB 20:RETURN
60 X=&HFF+&O17-&H0+&O0:Y=-1:Z=255:W=256:V=32767:U=32768!
70 ' a remark
80 DATA 1,"two, and",three:REM not crunched: PRINT
90 PRINT TAB(5);SPC(2);"x":PRINT USING "##";1
100 FOR I=1 TO 10 STEP 2:NEXT I:WHILE A<0:WEND
110 Z$=LEFT$(E$,1)+MID$(E$,2,1)+RIGHT$(E$,1)+CHR$(65)+STR$(1)+SPACE$(2)+INKEY$
120 Q=SQR(4)+INT(1.5)+ABS(-1)+SGN(-2)+LOG(1)+EXP(0)+SIN(0)+COS(0)+TAN(0)+ATN(0)
130 R=A AND B OR C XOR D EQV E IMP F MOD 3 \ 2 ^ 2 / 2 * 1
140 IF NOT A<>B AND A>=B OR A<=B THEN PRINT FNA(1);USR(0);VARPTR(A);ERL;ERR
150 SYSTEM:FILES:DATE$="x":A=CVI("ab")+FRE(0)+PEEK(0)+POS(0)+LPOS(0)+CINT(1)+FIX(1)
160 LOWER=1:GOTO 10
170 END
180 LIST
