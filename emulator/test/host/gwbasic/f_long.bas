10 REM files longer than one record, and than several
20 OPEN "O",#1,"FL1.TXT"
30 FOR I=1 TO 30:PRINT #1,"line";I:NEXT
40 CLOSE
50 OPEN "I",#1,"FL1.TXT":N=0:S=0
60 WHILE NOT EOF(1):INPUT #1,A$:N=N+1:S=S+VAL(MID$(A$,5)):WEND
70 PRINT N;S:CLOSE
80 OPEN "O",#2,"FL2.TXT"
90 FOR I=1 TO 400:PRINT #2,I;:NEXT:PRINT #2,
100 CLOSE
110 OPEN "I",#2,"FL2.TXT":N=0:S=0
120 WHILE NOT EOF(2):INPUT #2,X:N=N+1:S=S+X:WEND
130 PRINT N;S:CLOSE
140 OPEN "I",#1,"FL1.TXT":OPEN "I",#2,"FL2.TXT"
150 FOR I=1 TO 5:LINE INPUT #1,A$:INPUT #2,X:PRINT A$;X:NEXT
160 CLOSE
