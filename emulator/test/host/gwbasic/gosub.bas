10 REM GOSUB and RETURN: nesting, RETURN line, inside FOR loops
20 GOSUB 100:PRINT "back"
30 FOR I=1 TO 3:GOSUB 200:NEXT:PRINT
40 GOSUB 300:PRINT "not here"
50 PRINT "fifty"
60 FOR I=1 TO 2:GOSUB 400:PRINT "i";I:NEXT
70 X=0:GOSUB 500:PRINT "x";X
80 END
100 PRINT "in 100":GOSUB 150:PRINT "out of 150":RETURN
150 PRINT "in 150":RETURN
200 PRINT I*I;:RETURN
300 RETURN 50
400 FOR J=1 TO 10:IF J=3 THEN RETURN
410 NEXT J
500 X=X+1:IF X<5 THEN GOSUB 500
510 RETURN
