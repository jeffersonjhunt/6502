10 OPEN "R",#1,"RX1B.DAT",100
20 FIELD #1,100 AS A$
30 FOR I=1 TO 5:LSET A$=STRING$(100,48+I):PUT #1,I:NEXT
40 FOR K=1 TO 4:READ N:GET #1,N:Z=0:FOR J=1 TO 100:IF MID$(A$,J,1)=CHR$(0) THEN Z=Z+1
50 NEXT:PRINT N;Z;LEFT$(A$,1)=CHR$(0);EOF(1);LOC(1):NEXT
60 DATA 3,9,5,7
70 GET #1,6:Z=0:FOR J=1 TO 100:IF MID$(A$,J,1)=CHR$(0) THEN Z=Z+1
80 NEXT:PRINT Z;EOF(1)
90 CLOSE
