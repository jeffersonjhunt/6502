10 REM RESUME NEXT three GOSUBs deep inside FOR loops: the loops and RETURNs still right
20 ON ERROR GOTO 900
30 FOR I=1 TO 2
40 GOSUB 100
50 PRINT "main";I
60 NEXT I
70 GOSUB 500:PRINT "again"
80 PRINT "end":END
100 FOR J=1 TO 2:GOSUB 200:NEXT J:RETURN
200 GOSUB 300:PRINT "r200";:RETURN
300 FOR K=1 TO 2
310 PRINT I;J;K;
320 IF K=2 THEN X=1/0
330 NEXT K
340 RETURN
500 FOR L=1 TO 3:GOSUB 600:NEXT L:PRINT "L";L:RETURN
600 IF L=2 THEN ERROR 5
610 PRINT "s";L;:RETURN
900 PRINT "trap";ERL;
910 IF ERL=600 THEN RESUME 610
920 RESUME NEXT
