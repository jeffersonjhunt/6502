10 OPEN "R",#1,"RL1.DAT",1:FIELD #1,1 AS A$
20 FOR I=1 TO 300:LSET A$=CHR$(32+I MOD 90):PUT #1:NEXT:PRINT LOC(1)
30 S$="":FOR I=1 TO 300 STEP 37:GET #1,I:S$=S$+A$:NEXT:PRINT S$;LOC(1)
40 CLOSE
50 OPEN "RL2.DAT" AS #2 LEN=128:FIELD #2,64 AS L$,64 AS R$
60 FOR I=1 TO 4:LSET L$="left"+STR$(I):RSET R$="right"+STR$(I):PUT #2:NEXT
70 FOR I=4 TO 1 STEP -1:GET #2,I:PRINT LEFT$(L$,7);"|";RIGHT$(R$,7);LEN(L$):NEXT:CLOSE
80 OPEN "RL3.DAT" AS 3:FIELD 3,10 AS D$,118 AS E$:LSET D$="default"
90 PUT 3,2:GET 3,1:PRINT ASC(D$);:GET 3,2:PRINT D$;"!":CLOSE
