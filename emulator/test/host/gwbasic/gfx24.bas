5 REM 7e3's G22: GET's array layout, SCREEN 1 and 2: the bits, the rows, each row padded to a byte (PC-BASIC's)
10 DEFINT A-Z: DIM A(30), R$(20): NR=0
20 FOR M=1 TO 2: SCREEN M: CLS
30 C=3: IF M=2 THEN C=1
40 FOR Y=0 TO 3: FOR X=0 TO 12: PSET (X+20,Y+130),(X+Y) MOD (C+1): NEXT: NEXT
50 RESTORE 1000
60 READ X1,Y1,X2,Y2: IF X1<0 THEN 200
70 FOR I=0 TO 30: A(I)=-1: NEXT
80 GET (X1,Y1)-(X2,Y2),A
90 N=INT(((ABS(X2-X1)+1)*(3-M)+7)/8)*(ABS(Y2-Y1)+1)
100 S$="M"+STR$(M)+" ("+STR$(X1)+STR$(Y1)+")-("+STR$(X2)+STR$(Y2)+") A0="+STR$(A(0))+" A1="+STR$(A(1))+" :"
110 FOR K=0 TO N+1: V=A(2+K\2): IF K AND 1 THEN V=(V\256) AND 255 ELSE V=V AND 255
115 S$=S$+RIGHT$("0"+HEX$(V),2): NEXT
120 NR=NR+1: R$(NR)=S$: GOTO 60
200 NEXT M
210 SCREEN 0: FOR I=1 TO NR: PRINT R$(I): NEXT: END
1000 DATA 20,130,32,133, 21,130,32,133, 22,130,25,131, 32,133,20,130, 20,130,20,130, 23,131,23,131, 20,130,27,130, 21,130,29,130
1010 DATA -1,0,0,0
