10 OPEN "RORD.DAT" AS #1 LEN=100
20 FIELD #1,100 AS A$
30 FOR K=1 TO 6:READ N:LSET A$=STRING$(100,64+N):PUT #1,N:NEXT
40 DATA 3,1,5,2,4,3
50 LSET A$="changed":PUT #1,2
60 FOR N=1 TO 5:GET #1,N:PRINT N;LEFT$(A$,8);RIGHT$(A$,3);LOC(1):NEXT
70 GET #1,1:GET #1:PRINT LEFT$(A$,8);LOC(1):PUT #1:PRINT LOC(1)
80 CLOSE:OPEN "RORD.DAT" AS #1 LEN=100:FIELD #1,100 AS A$
90 GET #1,3:PRINT LEFT$(A$,3):GET #1,4:PRINT LEFT$(A$,3):CLOSE
