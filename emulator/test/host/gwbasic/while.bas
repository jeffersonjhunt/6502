10 REM WHILE and WEND: nesting, none, inside and around FOR
20 I=0:WHILE I<3:PRINT I;:I=I+1:WEND:PRINT
30 WHILE 0:PRINT "never":WEND:PRINT "none"
40 I=1
50 WHILE I<=3
60 J=1:WHILE J<=I:PRINT I*10+J;:J=J+1:WEND
70 I=I+1
80 WEND:PRINT
90 FOR K=1 TO 2:N=K:WHILE N>0:PRINT K;N;:N=N-1:WEND:NEXT:PRINT
100 A$="abc":WHILE LEN(A$):PRINT A$;" ";:A$=MID$(A$,2):WEND:PRINT
110 C=0
120 WHILE C<2:C=C+1:GOTO 120
130 WEND
