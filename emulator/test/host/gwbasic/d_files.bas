10 REM FILES: the names that match, as the 1983 source prints them
20 ON ERROR GOTO 900
30 OPEN "O",#1,"DFA.TXT":CLOSE:OPEN "O",#1,"DFB.TXT":CLOSE:OPEN "O",#1,"DFC.DAT":CLOSE
35 OPEN "O",#1,"DGA.TXT":CLOSE:OPEN "O",#1,"DFNOTYPE":CLOSE:OPEN "O",#1,"DFLONGNMX":CLOSE
38 FOR I=1 TO 8:OPEN "O",#1,"DW"+CHR$(48+I)+".TXT":CLOSE:NEXT
40 PRINT "a":FILES "DF*.TXT"
50 PRINT "b":FILES "df*"
60 PRINT "c":FILES "D?A.*"
70 PRINT "d":FILES "DFNOSUCH.*"
80 PRINT "e":FILES "DFA.TXT"
90 PRINT "f":FILES "DFLONGNMX"
100 PRINT "123456789012345";:FILES "DW*.TXT"
110 PRINT "g":FILES "DW*.TXT"
120 PRINT "h":FILES 1
130 PRINT "i":FILES ""
140 PRINT "j":FILES "DFABCDEFGHI.TXT"
150 KILL "DF*.*":KILL "DGA.TXT":KILL "DW*.TXT"
160 PRINT "k":FILES "D?A.*"
170 PRINT "done":END
900 PRINT "error";ERR;"in";ERL:RESUME NEXT
