10 REM FOR and NEXT: single and integer loops, steps, loops run no times
20 FOR I=1 TO 3:PRINT I;:NEXT I:PRINT "after";I
30 FOR J%=10 TO 1 STEP -3:PRINT J%;:NEXT:PRINT J%
40 FOR K=1 TO 0:PRINT "never":NEXT K:PRINT "none";K
50 FOR K%=5 TO 4:PRINT "never":NEXT:PRINT "none";K%
60 FOR X=0 TO 1 STEP .25:PRINT X;:NEXT X:PRINT
70 FOR X=1 TO -1 STEP -.5:PRINT X;:NEXT:PRINT
80 FOR A=1 TO 2:FOR B=1 TO 3:PRINT A*10+B;:NEXT B,A:PRINT A;B
90 FOR A=1 TO 2:FOR B%=1 TO 2:PRINT A;B%;:NEXT:NEXT:PRINT
100 S=0:FOR I=1 TO 100:S=S+I:NEXT:PRINT S
110 FOR I%=1 TO 3
120 PRINT "line";I%
130 NEXT I%
140 N=0
145 FOR I=1 TO 3:N=N+1:IF N<3 THEN 145
147 NEXT I
150 PRINT "re-entered";N;I
160 FOR I=1 TO 5 STEP 0:PRINT I;:IF I<5 THEN I=I+2:NEXT
170 PRINT
180 FOR I=1 TO 3:NEXT I:FOR I=7 TO 8:PRINT I;:NEXT:PRINT
190 FOR I=1.5 TO 3.5:PRINT I;:NEXT:PRINT
200 FOR I%=32760 TO 32767 STEP 5:PRINT I%;:NEXT
