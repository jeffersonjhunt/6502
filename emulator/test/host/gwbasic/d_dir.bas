10 REM CHDIR, MKDIR, RMDIR: the directory hook
20 ON ERROR GOTO 900
30 PRINT "a":CHDIR "\"
40 PRINT "b":CHDIR "."
50 PRINT "c":CHDIR ""
60 PRINT "d":CHDIR "NOSUCHD"
70 PRINT "e":MKDIR "NEWD"
80 PRINT "f":RMDIR "NOSUCHD"
90 PRINT "g":CHDIR 1
100 PRINT "h":MKDIR 2
110 PRINT "i":RMDIR 3
120 PRINT "j":D$="\":CHDIR D$+""
130 PRINT "done":END
900 PRINT "error";ERR;"in";ERL:RESUME NEXT
