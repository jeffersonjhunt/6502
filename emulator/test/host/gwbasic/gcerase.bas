10 DIM A$(50),B$(50),C$(50)
20 FOR I=0 TO 50:A$(I)=STRING$(20,65+I MOD 26):B$(I)="b"+STR$(I):C$(I)=STRING$(30,97+I MOD 26):NEXT
30 ERASE B$
40 K$="keep"
50 FOR R=1 TO 30:FOR I=0 TO 50:T$=STRING$(40,48+I MOD 10)+STR$(R):NEXT:NEXT
60 OK=1:FOR I=0 TO 50:IF A$(I)<>STRING$(20,65+I MOD 26) THEN OK=0
70 IF C$(I)<>STRING$(30,97+I MOD 26) THEN OK=0
80 NEXT:PRINT OK;K$;T$
90 DIM B$(10):B$(3)="new":PRINT B$(3);" ";A$(50);" ";C$(0)
