10 REM CLOSE: one, a list, all, one not open
20 ON ERROR GOTO 900
30 OPEN "O",#1,"FC1.TXT":OPEN "O",#2,"FC2.TXT":OPEN "O",#3,"FC3.TXT"
40 PRINT #1,"f1":PRINT #2,"f2":PRINT #3,"f3"
50 CLOSE #2
60 PRINT "a":PRINT #2,"x"
70 PRINT "b":PRINT #1,"g1":PRINT #3,"g3"
80 CLOSE #1,3
90 PRINT "c":PRINT #1,"x"
100 PRINT "d":PRINT #3,"x"
110 CLOSE #3:CLOSE 2:CLOSE
120 OPEN "I",#1,"FC1.TXT":OPEN "I",#2,"FC2.TXT":OPEN "I",#3,"FC3.TXT"
130 FOR F=1 TO 3:WHILE NOT EOF(F):LINE INPUT #F,A$:PRINT A$;" ";:WEND:NEXT
140 PRINT:CLOSE
150 PRINT "e":PRINT EOF(1)
160 OPEN "I",#1,"FC1.TXT":OPEN "I",2,"FC2.TXT":CLOSE 1,#2
170 PRINT "f":PRINT EOF(2)
180 OPEN "I",#3,"FC3.TXT":CLOSE #3,#3:CLOSE 3
190 PRINT "done":END
900 PRINT "error";ERR;"in";ERL:RESUME NEXT
