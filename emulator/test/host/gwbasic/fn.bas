10 REM DEF FN and FN: each type, 0 to 3 parameters, nesting, redefinition
20 DEF FNA(X)=X*2+1
30 PRINT FNA(3);FNA(-1.5)
40 DEF FNI%(X)=X*1.5
50 PRINT FNI%(3);FNI%(5);FNI%(-3)
60 DEF FND#(X#)=X#/3
70 PRINT FND#(1);FNA(1/3)
80 DEF FNS$(A$,N)=LEFT$(A$,N)+"!"
90 PRINT FNS$("hello",3);FNS$("ab",0)
100 DEF FNP=3.25
110 PRINT FNP*2;FNP
120 DEF FNM(A,B,C)=A*100+B*10+C
130 PRINT FNM(1,2,3);FNM(9,8,7)
140 X=5:Y$="keep":DEF FNG(X)=X*X:DEF FNH$(Y$)=Y$+Y$
150 PRINT FNG(4);X;FNH$("z");Y$
160 DEF FNK(X%)=X%:PRINT FNK(2.6);FNK(-2.4)
170 DEF FNC$(Q)=CHR$(Q+64):PRINT FNC$(1);FNC$(26)
180 PRINT FNA(FNA(2));FNM(FNA(1),FNG(2),FNP)
190 DEF FNN(X)=X+FNG(X+1):PRINT FNN(2)
200 DEF FNO(Y)=Y+X:PRINT FNO(1)
220 FOR I=1 TO 3:PRINT FNA(I);:NEXT I:PRINT
230 GOSUB 300:PRINT FNA(10)
240 DEF FNA(X)=X-1:PRINT FNA(10)
250 DEF FNU$(U$)=U$+".":B$="ab":PRINT FNU$(B$)+FNU$("cd")+FNU$(B$+"x");B$
260 DEF FNE(A,B)=A^B:PRINT FNE(2,10);FNE(B,A)
270 PRINT FNI%(2)/4;FND#(2)*3;FNS$(FNC$(2),1)
280 Z=FNG(3)+FNA(1):PRINT Z;Q;A;B;C;N
290 END
300 PRINT "sub";FNA(100):RETURN
