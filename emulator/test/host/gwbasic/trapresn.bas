10 REM RESUME line and RESUME 0; ON ERROR GOTO inside the handler; an unknown code
20 ON ERROR GOTO 100
30 N=N+1:PRINT "try";N
40 IF N<3 THEN ERROR 200
50 PRINT "ok";N
60 ON ERROR GOTO 300
70 ERROR 201
80 PRINT "eighty"
90 ERROR 9
95 ERROR 10
97 PRINT "done":END
100 PRINT "e";ERR;ERL:RESUME 30
300 PRINT "f";ERR;ERL:IF M=0 THEN M=1:RESUME 0
310 IF M=1 THEN M=2:RESUME 80
320 PRINT "h1";ERR:ON ERROR GOTO 400:RESUME NEXT
400 PRINT "h2";ERR:RESUME NEXT
