10 REM 7e1's G3: block 1 is back in W1 after every graphics statement: P() lies across $4000-$7FFF (by hand)
20 DEFINT A-Z: DIM P(9600): FOR I=0 TO 9600 STEP 16: P(I)=I XOR 21845: NEXT
30 P$="P "+HEX$(VARPTR(P(0)))+" "+HEX$(VARPTR(P(9600)))
40 SCREEN 1: GOSUB 900: PSET (5,5),2: GOSUB 900: PRESET (5,5): GOSUB 900: LINE (0,0)-(100,100),3: GOSUB 900
50 LINE (10,10)-(50,50),1,BF: GOSUB 900: LINE (10,10)-(50,50),2,B: GOSUB 900: X=POINT(5,5): GOSUB 900
60 CLS: GOSUB 900: COLOR 1,1: GOSUB 900: SCREEN 2: GOSUB 900: PSET (600,190): GOSUB 900: LINE (0,0)-(639,199): GOSUB 900
70 LINE (0,100)-(639,199),1,BF: GOSUB 900: X=POINT(600,190): GOSUB 900: CLS: GOSUB 900: SCREEN 0: GOSUB 900
80 PRINT P$: PRINT "CHECKS";K;"BAD";B
90 END
900 K=K+1: FOR I=0 TO 9600 STEP 16: IF P(I)<>(I XOR 21845) THEN B=B+1
910 NEXT: RETURN
