10 REM OPEN's two forms and its modes
20 OPEN "O",#1,"FM1.TXT":PRINT #1,"one":CLOSE #1
30 OPEN "a",1,"FM1.TXT":PRINT #1,"two":CLOSE 1
40 OPEN "FM1.TXT" FOR APPEND AS #2:PRINT #2,"three":CLOSE #2
50 OPEN "FM1.TXT" FOR INPUT AS 3
60 WHILE NOT EOF(3):LINE INPUT #3,A$:PRINT A$:WEND
70 CLOSE #3
80 OPEN "FM2.TXT" FOR OUTPUT AS #1:WRITE #1,"new",1:CLOSE
90 OPEN "i",#2,"FM2.TXT":INPUT #2,A$,N:PRINT A$;N:CLOSE
100 OPEN "Output",#1,"FM2.TXT":PRINT #1,"replaced":CLOSE
110 OPEN "FM2.TXT" FOR INPUT AS #1:LINE INPUT #1,A$:PRINT A$;EOF(1):CLOSE
120 OPEN "FM3.TXT" FOR APPEND AS #1:PRINT #1,"made by append":CLOSE
130 OPEN "I",#1,"FM3.TXT":LINE INPUT #1,A$:PRINT A$:CLOSE
140 OPEN "O",#1,"FM4.TXT":CLOSE:OPEN "I",#1,"FM4.TXT":PRINT EOF(1):CLOSE
150 OPEN "FM4.TXT" FOR APPEND AS #1:PRINT #1,"after empty":CLOSE
160 OPEN "I",#1,"FM4.TXT":LINE INPUT #1,A$:PRINT A$:CLOSE
170 PRINT "done"
