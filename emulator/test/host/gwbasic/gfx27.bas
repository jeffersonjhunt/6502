5 REM 7e3's G25: GET and PUT with the sprite's array S() in $4000-$7FFF, Q() across $4000 and P() across $8000 (by hand)
10 DEFINT A-Z: DIM Q(1500),S(2000),P(8000),T(2000)
20 FOR I=0 TO 1500: Q(I)=I XOR 13107: NEXT: FOR I=0 TO 8000 STEP 4: P(I)=I XOR 21845: NEXT
30 Q$="Q "+HEX$(VARPTR(Q(0)))+" "+HEX$(VARPTR(Q(1500)))+" S "+HEX$(VARPTR(S(0)))+" "+HEX$(VARPTR(S(2000)))+" P "+HEX$(VARPTR(P(0)))+" "+HEX$(VARPTR(P(8000)))
40 FOR M=1 TO 2: SCREEN M: W=48*M: N=1+(W*(3-M)\8)*24
50 FOR Y=0 TO 47: FOR X=0 TO W-1: PSET (X+10,Y+10),(X\3+Y\5) MOD (6-M*2): NEXT: NEXT
60 GET (10,10)-(9+W,57),S: GOSUB 900: FOR I=0 TO N: T(I)=S(I): NEXT
70 CLS: PUT (101,61),S,PSET: GOSUB 900: PUT (200,100),S,PSET: GOSUB 900: PUT (8,140),S,XOR: GOSUB 900
80 GET (101,61)-(100+W,108),S: GOSUB 900: FOR I=0 TO N: IF S(I)<>T(I) THEN D=D+1
90 NEXT: GET (200,100)-(199+W,147),S: GOSUB 900: FOR I=0 TO N: IF S(I)<>T(I) THEN D=D+1
100 NEXT: GET (8,140)-(7+W,187),S: GOSUB 900: FOR I=0 TO N: IF S(I)<>T(I) THEN D=D+1
110 NEXT: NEXT M
120 SCREEN 0: PRINT Q$: PRINT "CHECKS";K;"BAD";B;"DIFF";D
130 END
900 K=K+1: FOR I=0 TO 1500 STEP 3: IF Q(I)<>(I XOR 13107) THEN B=B+1
910 NEXT: FOR I=0 TO 8000 STEP 4: IF P(I)<>(I XOR 21845) THEN B=B+1
920 NEXT: RETURN
