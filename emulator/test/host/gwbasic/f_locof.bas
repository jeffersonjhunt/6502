10 REM LOC and LOF
20 OPEN "O",#1,"FLC.TXT"
30 PRINT LOC(1);
40 FOR I=1 TO 50:PRINT #1,"0123456789":NEXT
50 PRINT LOC(1);
60 CLOSE
70 OPEN "I",#1,"FLC.TXT":PRINT LOC(1);LOF(1);
80 FOR I=1 TO 13:LINE INPUT #1,A$:NEXT:PRINT LOC(1);
90 WHILE NOT EOF(1):LINE INPUT #1,A$:WEND:PRINT LOC(1);LOF(1)
100 CLOSE
110 OPEN "O",#1,"FLC2.TXT":PRINT #1,"x":CLOSE
120 OPEN "I",#1,"FLC2.TXT":PRINT LOF(1):CLOSE
