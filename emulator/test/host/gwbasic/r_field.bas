10 ON ERROR GOTO 300
20 OPEN "R",#1,"RF.DAT",20
30 FIELD #1,10 AS A$,10 AS B$:PRINT LEN(A$);LEN(B$)
40 FIELD #1,15 AS C$,6 AS D$
50 FIELD #1,256 AS E$
60 FIELD #1,5 AS X
70 FIELD 2,5 AS F$
80 OPEN "O",#2,"RF2.TXT":FIELD #2,5 AS F$:PUT #2,1:GET #2:CLOSE #2
90 LSET A$="aaaaaaaaaaaa":RSET B$="bb":PUT #1,1:GET #1,1:PRINT A$;"|";B$;"|"
100 FIELD #1,20 AS W$:PRINT W$;"|"
110 A$="x":PRINT A$;W$;"|":LSET A$="yz":PRINT A$;"|";W$
120 GET #1,0
130 GET #1,32768
140 PUT #1,-1
150 PRINT #1,"ab";:PRINT #1,"cd":PUT #1,2:GET #1,2:GOSUB 200
160 PRINT #1,STRING$(21,"z")
170 GET #1,2:INPUT #1,X$:PRINT X$
180 WRITE #1,"q",1:PUT #1,3:GET #1,3:GOSUB 200
190 CLOSE:END
200 FOR J=1 TO 20:PRINT ASC(MID$(W$,J,1));:IF J=10 THEN PRINT
210 NEXT:PRINT:RETURN
300 PRINT "err";ERR;ERL:RESUME NEXT
