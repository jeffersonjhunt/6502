210 PRINT "sub 210";:RETURN
220 PRINT "sub 220";:RETURN
300 J=3:ON  J  GOTO  310 , 320 , 330
310 PRINT "310":END
320 PRINT "320":END
330 PRINT "330"
340 ON 4 GOTO 350,360,:PRINT "past a comma"
350 ON 2 GOSUB 360,370:PRINT "after 370":ON J-2 GOSUB 360:PRINT "after 360"
