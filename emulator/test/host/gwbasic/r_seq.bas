10 OPEN "O",#1,"RS.TXT":PRINT #1,"HELLO WORLD":CLOSE
20 OPEN "R",#1,"RS.TXT",5:FIELD #1,5 AS A$:GET #1,1:PRINT A$;"|";:GET #1:PRINT A$;"|";LOC(1):CLOSE
30 OPEN "R",#1,"RS.TXT",4:FIELD #1,4 AS A$
40 FOR I=1 TO 3:LSET A$=CHR$(64+I)+CHR$(96+I)+CHR$(13)+CHR$(10):PUT #1,I:NEXT:CLOSE
50 OPEN "I",#1,"RS.TXT":FOR I=1 TO 3:LINE INPUT #1,L$:PRINT L$;:NEXT:PRINT:CLOSE
60 OPEN "A",#1,"RS2.TXT":PRINT #1,"12345678":CLOSE
70 OPEN "RS2.TXT" AS #1 LEN=2:FIELD #1,2 AS B$:GET #1,3:PRINT B$:CLOSE
