5 REM 7e5's G45: the OO-1's modes keep block 1 (G3's method): S() in $4000-$7FFF, Q() across $4000, P() across $8000
10 DEFINT A-Z: DIM Q(1500),S(2000),P(8000),T(2000)
20 FOR I=0 TO 1500: Q(I)=I XOR 13107: NEXT: FOR I=0 TO 8000 STEP 4: P(I)=I XOR 21845: NEXT
30 Q$="Q "+HEX$(VARPTR(Q(0)))+" "+HEX$(VARPTR(Q(1500)))+" S "+HEX$(VARPTR(S(0)))+" "+HEX$(VARPTR(S(2000)))+" P "+HEX$(VARPTR(P(0)))+" "+HEX$(VARPTR(P(8000)))
40 FOR M=10 TO 12: SCREEN M: GOSUB 900: MX=639: MC=1: IF M=10 THEN MX=255: MC=255
50 IF M=11 THEN MX=511: MC=15
60 PSET (5,5),MC: GOSUB 900: PRESET (5,5): GOSUB 900: LINE (0,0)-(MX,199),MC: GOSUB 900: LINE (10,10)-(60,60),MC,BF: GOSUB 900
70 LINE (100,10)-(150,60),MC,B: GOSUB 900: PAINT (120,30),1,MC: GOSUB 900: CIRCLE (200,100),30,MC: GOSUB 900: DRAW "BM5,150 R20 D20": GOSUB 900
80 FOR Y=0 TO 15: LINE (0,200+Y)-(199,200+Y),(Y+1) AND MC: NEXT: PSET (3,203),0: PSET (198,214),0
90 GET (0,200)-(199,215),S: GOSUB 900: PUT (50,180),S,PSET: GOSUB 900: GET (50,180)-(249,195),T: GOSUB 900
100 N=(S(0)\8+1)*16\2+2: FOR I=0 TO N: IF S(I)<>T(I) THEN D=D+1
110 NEXT: PUT (50,180),S,XOR: GOSUB 900: X=POINT(5,5): GOSUB 900: VIEW (10,10)-(100,100),1,MC: GOSUB 900: CLS: GOSUB 900: VIEW: GOSUB 900
120 IF M<12 THEN COLOR 1: GOSUB 900
130 A=SCREEN(1,1): GOSUB 900: CLS: GOSUB 900: NEXT M
140 SCREEN 0: PRINT Q$: PRINT "CHECKS";K;"BAD";B;"DIFF";D
150 END
900 K=K+1: FOR I=0 TO 1500 STEP 3: IF Q(I)<>(I XOR 13107) THEN B=B+1
910 NEXT: FOR I=0 TO 8000 STEP 8: IF P(I)<>(I XOR 21845) THEN B=B+1
920 NEXT: RETURN
