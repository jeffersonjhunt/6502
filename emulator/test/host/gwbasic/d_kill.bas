10 REM KILL: a file deleted, then gone; the errors
20 ON ERROR GOTO 900
30 OPEN "O",#1,"DK1.TXT":PRINT #1,"one":CLOSE
40 PRINT "a":KILL "DK1.TXT"
50 PRINT "b":OPEN "I",#1,"DK1.TXT"
60 PRINT "c":KILL "DK1.TXT"
70 PRINT "d":OPEN "O",#1,"dk2.txt":PRINT #1,"two":CLOSE
80 PRINT "e":OPEN "I",#2,"DK2.TXT":KILL "dk2.txt"
90 PRINT "f":CLOSE:KILL "dk2.txt":OPEN "I",#1,"DK2.TXT"
100 PRINT "g":KILL ""
110 PRINT "h":KILL 5
120 PRINT "i":OPEN "O",#1,"DKW1.TXT":CLOSE:OPEN "O",#1,"DKW2.TXT":CLOSE:OPEN "O",#1,"DKX.DAT":CLOSE
130 PRINT "j":KILL "DKW?.TXT"
140 PRINT "k":OPEN "I",#1,"DKW1.TXT"
150 PRINT "l":OPEN "I",#1,"DKW2.TXT"
160 PRINT "m":OPEN "I",#1,"DKX.DAT":PRINT "kept":CLOSE
170 PRINT "n":KILL "DK*.*"
180 PRINT "o":OPEN "I",#1,"DKX.DAT"
190 PRINT "p":X$="DK3.TXT":OPEN "O",#1,X$:CLOSE:KILL X$:KILL X$
200 PRINT "done":END
900 PRINT "error";ERR;"in";ERL:RESUME NEXT
