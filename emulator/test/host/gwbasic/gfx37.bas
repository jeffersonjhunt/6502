5 REM 7e4's G36: the array Q() across $4000 and the tile's string in $4000-$7FFF (CLEAR's top &H7000), by hand
10 CLEAR ,&H7000: DEFINT A-Z: DIM Q(6000)
20 FOR I=0 TO 6000 STEP 3: Q(I)=I XOR 13107: NEXT
30 T$=CHR$(&H1B)+CHR$(&HE4): T$=T$+"": A=VARPTR(T$): Q$="Q "+HEX$(VARPTR(Q(0)))+" "+HEX$(VARPTR(Q(6000)))+" T "+HEX$(PEEK(A+1)+256*PEEK(A+2))
40 SCREEN 1: VIEW (10,10)-(100,100),1,2: GOSUB 900: CLS: GOSUB 900
50 LINE (0,0)-(80,0),3,,&HAAAA: GOSUB 900
60 VIEW: LINE (0,110)-(40,130),3,B: PAINT (20,120),T$,3: GOSUB 900
70 WINDOW (0,0)-(1,1): PSET (.5,.5),2: GOSUB 900: X!=PMAP(.5,0)+POINT(2): GOSUB 900: WINDOW: GOSUB 900
80 S$="": FOR Y=111 TO 112: FOR X=1 TO 8: S$=S$+CHR$(48+POINT(X,Y)): NEXT: NEXT
90 SCREEN 0: PRINT Q$: PRINT "CHECKS";K;"BAD";B: PRINT "TILE ";S$
100 END
900 K=K+1: FOR I=0 TO 6000 STEP 3: IF Q(I)<>(I XOR 13107) THEN B=B+1
910 NEXT: RETURN
