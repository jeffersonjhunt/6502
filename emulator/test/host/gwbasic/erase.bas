10 DIM A(10),B$(5),C%(3,3)
20 A(3)=5:B$(2)="kept":C%(1,1)=7
30 ERASE A
40 PRINT B$(2);C%(1,1)
50 DIM A(20):PRINT A(3);A(20)
60 ERASE B$,C%
70 DIM B$(2):PRINT "[";B$(2);"]"
