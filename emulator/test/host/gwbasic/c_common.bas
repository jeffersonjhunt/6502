10 OPEN "O",#1,"CC1.BAS"
20 PRINT #1,"10 COMMON A%,B!,C#,D$,E(),F$(),G"
30 PRINT #1,"20 PRINT A%;B!;C#;D$;G;X"
40 PRINT #1,"30 FOR I=0 TO 3:PRINT E(I);F$(I);:NEXT:PRINT"
50 PRINT #1,"40 PRINT LEN(Y$);H(2);LONGNAME$;M%(1,2)"
60 CLOSE
70 COMMON A%,B!,C#,D$,E(),F$()
80 COMMON G, LONGNAME$ ,M%( )
90 A%=12:B!=3.5:C#=1.23456789012345#:D$="LITERAL":G=7:X=99:Y$="GONE"
100 DIM E(3),F$(3),H(5),M%(2,3):H(2)=5:M%(1,2)=-7:LONGNAME$="LONG"+"NAME"
110 FOR I=0 TO 3:E(I)=I*I:F$(I)=CHR$(65+I)+"x":NEXT
120 CHAIN "CC1"
