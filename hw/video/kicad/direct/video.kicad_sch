  (text "TFP410 straps: ISEL=0 (no I2C), BSEL=1 (24-bit), DSEL=0, EDGE=1 (rising), DKEN=0, VREF=3.3 V.\nDATA[23:16] red, [15:8] green, [7:0] blue. TX0 blue, TX1 green, TX2 red.\nADV7123: top 8 bits of each channel driven, bottom 2 tied low; RSET 536 for 0.7 V into 37.5 ohm.\nPrototype has no TPD12S016 (ESD); the final card adds it between the TFP410 and the socket."
    (at 40 20 0)
    (effects
      (font (size 2 2))
      (justify left top))
    (uuid "267e357c-58c3-48a2-89df-77a80c80c80d")))
