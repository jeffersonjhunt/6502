10 REM PLOT POINTS ON UNIT CIRCLE, STEP -3.141592654 WITH ROUNDING
20 PI=3.141592654
30 FOR I=2*PI TO 0 STEP -PI
40 X=COS(I)
50 Y=SIN(I)
60 REM ROUND X AND Y TO NEAREST INTEGER IF CLOSE
70 IF ABS(X-INT(X+0.5))<0.01 THEN X=INT(X+0.5)
80 IF ABS(Y-INT(Y+0.5))<0.01 THEN Y=INT(Y+0.5)
90 PRINT "ANGLE:";I;" X:";X;" Y:";Y
100 NEXT I
