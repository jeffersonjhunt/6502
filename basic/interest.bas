10 REM THIS PROGRAM COMPUTES INTEREST PAYMENTS
20 INPUT "INTEREST IN PERCENT ";J
30 LET J=J/100
40 INPUT "AMOUNT OF LOAN ";A
50 INPUT "NUMBER OF YEARS ";N
60 INPUT "NUMBER OF PAYMENTS PER YEAR ";M
70 LET N=N*M : I=J/M : B=1+I
80 LET R=A*I/(1-1/B^N)
90 PRINT
100 PRINT "AMOUNT PER PAYMENT ="; INT(R*10^2+0.5)/10^2
110 PRINT "TOTAL INTEREST     ="; INT((R*N-A)*10^2+0.5)/10^2
120 PRINT
130 LET B=A
140 PRINT "INTEREST    APP TO PRIN      BALANCE OF PRIN"
150 LET L=B*I : P=R-L : B=B-P
160 PRINT INT (L*10^2+0.5)/10^2,
170 PRINT INT (P*10^2+0.5)/10^2,
180 PRINT INT (B*10^2+0.5)/10^2
190 IF B>=R GOTO 150
200 PRINT INT ((B*I)*10^2+0.5)/10^2, INT ((R-B*I)*10^2+0.5)/10^2
210 PRINT 
220 PRINT "LAST PAYMENT = "; INT((B*I+B)*10^2+0.5)/10^2
230 END
